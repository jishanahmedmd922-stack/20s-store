
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "20s-store",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "20s-store-db",
      "database_id": "f710c1b8-e36f-47a4-9f07-87f193d0c32e"
    }
  ],
  "observability": {
    "enabled": true
  }
}

